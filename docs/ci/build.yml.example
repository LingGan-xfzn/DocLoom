name: build

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest

    steps:
      - uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Restore
        run: dotnet restore DocLoom.sln

      - name: Build
        run: dotnet build DocLoom.sln -c Release --no-restore

      - name: Publish single-file exe
        run: dotnet publish src/DocLoom.App/DocLoom.App.csproj -c Release -r win-x64 --self-contained true -o dist

      - name: CLI smoke check
        run: |
          if (Test-Path docs/sample.docx) {
            dotnet run --project tools/DocLoom.Cli -c Release -- docs/sample.docx --json | Out-Null
          } else {
            Write-Output "no sample document, skipping"
          }
        shell: pwsh

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: DocLoom-win-x64
          path: dist/DocLoom.exe
          if-no-files-found: error

      - name: Attach exe to release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/DocLoom.exe
          generate_release_notes: true