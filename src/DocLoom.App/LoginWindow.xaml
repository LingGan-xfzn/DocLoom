<Window x:Class="DocLoom.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录秀米"
        Width="940" Height="720"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Border x:Name="RootBorder"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradientBrush}">
                        <Path Data="{StaticResource IconUser}" Style="{StaticResource IconStroke}"
                              Width="15" Height="15" Stroke="{StaticResource AccentInkBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="登录秀米账号" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="登录信息只保存在本机内存，关掉软件即失效"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Margin="0,0,10,0"
                        Style="{StaticResource CloseTitleBarButton}" Click="Close_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconStrokeSmall}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="14,0" CornerRadius="12" ClipToBounds="True"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="Browser" />
                    <StackPanel x:Name="LoadingLayer" Background="{StaticResource SurfaceBrush}"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconStroke}"
                              Width="26" Height="26" Stroke="{StaticResource AccentBrush}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                        <TextBlock Text="正在打开秀米登录页…" Margin="0,12,0,0"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource WarningBrush}" />
                    <TextBlock x:Name="StatusText" Text="等待登录…" Margin="8,0,0,0"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="InstallRuntimeButton" Content="下载 WebView2 运行时"
                            Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,0"
                            Click="InstallRuntime_Click" Visibility="Collapsed" />
                    <Button x:Name="RetryButton" Content="重新加载页面" Style="{StaticResource GhostButton}"
                            Padding="12,6" Click="Retry_Click" Visibility="Collapsed" />
                    <Button x:Name="DoneButton" Content="我已登录" Style="{StaticResource PrimaryButton}"
                            Padding="16,7" Margin="10,0,0,0" Click="Done_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>