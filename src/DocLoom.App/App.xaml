<Application x:Class="DocLoom.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DocLoom.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <conv:EmptyStringToInverseVisibilityConverter x:Key="EmptyStringToInverseVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:ToastKindToBrushConverter x:Key="ToastKindToBrush" />
            <conv:ToastKindToIconConverter x:Key="ToastKindToIcon" />
        </ResourceDictionary>
    </Application.Resources>
</Application>