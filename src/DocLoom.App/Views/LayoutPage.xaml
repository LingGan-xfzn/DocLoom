<UserControl x:Class="DocLoom.App.Views.LayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:DocLoom.App.Services"
             xmlns:vm="clr-namespace:DocLoom.App.ViewModels"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="LayoutDocList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4D2DD4BF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.IsEnabled="True" Padding="0,0,4,0">
        <StackPanel MaxWidth="880" Margin="26,18,26,26" HorizontalAlignment="Center">

            <!-- 账号 -->
            <Border Style="{StaticResource PanelCard}" Padding="18,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="秀米账号" Style="{StaticResource TextLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Path Data="{StaticResource IconUser}" Style="{StaticResource IconStroke}"
                                  Stroke="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding AccountText}" Margin="8,0,0,0"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AccountDetail}" Margin="0,4,0,0"
                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Padding="12,7"
                                Command="{Binding OpenMyDocumentsCommand}"
                                Content="打开我的文档"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="8,0,0,0"
                                Command="{Binding LoginCommand}"
                                Content="登录秀米"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="8,0,0,0"
                                Command="{Binding LogoutCommand}"
                                Content="退出"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 模板 -->
            <Border Style="{StaticResource PanelCard}" Padding="18,16" Margin="0,12,0,0">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="排版模板" Style="{StaticResource TextLabel}" />
                            <Border Style="{StaticResource Chip}"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="#4D2DD4BF" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsBuiltInTemplate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="内置" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TemplateTitle}" Margin="0,6,0,0"
                                   FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding TemplateSummary}" Margin="0,4,0,0"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TemplatePathText}" Margin="0,3,0,0"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IsCustomTemplate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SubtleButton}" Padding="10,7" Margin="0,0,8,0"
                                Command="{Binding UseBuiltInTemplateCommand}"
                                Content="用内置模板"
                                Visibility="{Binding IsCustomTemplate, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource GhostButton}" Padding="14,8"
                                Command="{Binding PickTemplateCommand}"
                                Content="选择 .xiumi-key" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 文档 -->
            <Border Style="{StaticResource PanelCard}" Padding="18,16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="选择要排版的文档" Style="{StaticResource TextLabel}" />
                    <TextBlock Text="{Binding SelectedDocumentSummary}" Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding PlanSummary}" Margin="0,4,0,0"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding HasSelectedDocument, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox Style="{StaticResource LayoutDocList}"
                             ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                             MaxHeight="196" Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconFile}"
                                          Style="{StaticResource IconStrokeSmall}"
                                          Stroke="{StaticResource TextMutedBrush}" Margin="0,0,9,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding Model.Paragraphs.Count, Mode=OneWay}" />
                                        <Run Text=" 段 · " />
                                        <Run Text="{Binding Model.Images.Count, Mode=OneWay}" />
                                        <Run Text=" 图" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="列表为空：先到「文档处理」页拖入一篇文档，再回到这里"
                               Margin="0,10,0,0" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding Documents.Count, Converter={StaticResource ZeroToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 执行 -->
            <Border Style="{StaticResource PanelCard}" Padding="18,16" Margin="0,12,0,0">
                <StackPanel>
                    <Button Style="{StaticResource ActionButton}" Height="46"
                            Command="{Binding PublishCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconSpark}" Style="{StaticResource IconStroke}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="一键排版并保存到秀米" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ProgressBar Style="{StaticResource SlimProgressBar}" Margin="0,8,0,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                    </StackPanel>

                    <Border Margin="0,14,0,0" Padding="13,11" CornerRadius="10"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconStrokeSmall}"
                                      Stroke="{StaticResource SuccessBrush}" />
                                <TextBlock Text="已保存到你的秀米文档" Margin="7,0,0,0"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                            <TextBox Style="{StaticResource PathBox}" Margin="0,9,0,0"
                                     Text="{Binding ResultText, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="12,6"
                                        Command="{Binding OpenResultCommand}" Content="打开作品" />
                                <Button Style="{StaticResource SubtleButton}" Padding="10,6" Margin="8,0,0,0"
                                        Command="{Binding OpenMyDocumentsCommand}" Content="打开我的图文" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="13,10" CornerRadius="10"
                            Background="#1416A34A" BorderBrush="#33F5A524" BorderThickness="1"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAlert}" Style="{StaticResource IconStrokeSmall}"
                                  Stroke="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding NotesText}" Margin="9,0,0,0" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <TextBlock Margin="4,16,4,0" FontSize="10.5" LineHeight="17" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="排布说明：内容与顺序完全按选中的文档来——文档有几段就生成几个文本组件、有几张图就生成几个图片组件，段与段之间不会被合并。模板只提供样式基因（正文字体字号、行距、图片格式、边框装饰、署名块样式）。往期推荐区块按模板原样保留，条目标题是占位文字。封面默认取文档第一张图片。模板自带的账号图会自动过户到你的账号，首次排版会多花十几秒；登录态只在本次运行内保留。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>