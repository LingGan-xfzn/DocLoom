<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        动效语言：统一时长与缓动，禁止各处自定时长。
        原则：进入用 EaseOut（开头快、收尾稳），退出用 EaseIn；位移距离小（≤12px）；
        只动 Opacity / Translate / Scale，不动宽高，避免布局抖动。
    -->

    <Duration x:Key="DurInstant">0:0:0.09</Duration>
    <Duration x:Key="DurFast">0:0:0.14</Duration>
    <Duration x:Key="DurBase">0:0:0.20</Duration>
    <Duration x:Key="DurSlow">0:0:0.32</Duration>
    <Duration x:Key="DurAmbient">0:0:0.55</Duration>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseIn" EasingMode="EaseIn" />
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />
    <BackEase x:Key="EaseBackOut" EasingMode="EaseOut" Amplitude="0.35" />
    <SineEase x:Key="EaseSineOut" EasingMode="EaseOut" />

</ResourceDictionary>