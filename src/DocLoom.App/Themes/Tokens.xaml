<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DocLoom 设计令牌 · Dark Ink Studio
        深色专业工作台：墨黑底 + 青绿强调 + 琥珀动作色。
        对比度：正文 #E9F2F6 / #0F1820 ≈ 15:1，次要文字 #A3B8C6 ≈ 8:1，均高于 4.5:1。
    -->

    <Color x:Key="BgColor">#FF0A0F14</Color>
    <Color x:Key="SurfaceColor">#FF0F1820</Color>
    <Color x:Key="SurfaceRaisedColor">#FF13202A</Color>
    <Color x:Key="CardColor">#FF16232E</Color>
    <Color x:Key="CardHoverColor">#FF1B2C39</Color>
    <Color x:Key="CardActiveColor">#FF203341</Color>
    <Color x:Key="BorderColor">#FF22323F</Color>
    <Color x:Key="BorderSoftColor">#FF1A2833</Color>
    <Color x:Key="BorderStrongColor">#FF2F4454</Color>
    <Color x:Key="TextPrimaryColor">#FFE9F2F6</Color>
    <Color x:Key="TextSecondaryColor">#FFA3B8C6</Color>
    <Color x:Key="TextMutedColor">#FF7B92A2</Color>
    <Color x:Key="AccentColor">#FF2DD4BF</Color>
    <Color x:Key="AccentDeepColor">#FF14B8A6</Color>
    <Color x:Key="AccentSoftColor">#FF123B37</Color>
    <Color x:Key="AccentInkColor">#FF052421</Color>
    <Color x:Key="AmberColor">#FFF5A524</Color>
    <Color x:Key="AmberDeepColor">#FFD98B12</Color>
    <Color x:Key="AmberInkColor">#FF241703</Color>
    <Color x:Key="SuccessColor">#FF4ADE80</Color>
    <Color x:Key="WarningColor">#FFF5A524</Color>
    <Color x:Key="DangerColor">#FFF26B6B</Color>
    <Color x:Key="InfoColor">#FF60A5FA</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardActiveBrush" Color="{StaticResource CardActiveColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberDeepBrush" Color="{StaticResource AmberDeepColor}" />
    <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3EE8D2" Offset="0" />
        <GradientStop Color="#FF14B8A6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGlowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#332DD4BF" Offset="0" />
        <GradientStop Color="#002DD4BF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Microsoft YaHei, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeXs" xmlns:sys="clr-namespace:System;assembly=System.Runtime">11</sys:Double>
    <sys:Double x:Key="FontSizeSm" xmlns:sys="clr-namespace:System;assembly=System.Runtime">12</sys:Double>
    <sys:Double x:Key="FontSizeBase" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLg" xmlns:sys="clr-namespace:System;assembly=System.Runtime">15</sys:Double>
    <sys:Double x:Key="FontSizeXl" xmlns:sys="clr-namespace:System;assembly=System.Runtime">18</sys:Double>

    <CornerRadius x:Key="CornerLg">16</CornerRadius>
    <CornerRadius x:Key="CornerMd">12</CornerRadius>
    <CornerRadius x:Key="CornerSm">8</CornerRadius>
    <CornerRadius x:Key="CornerXs">6</CornerRadius>

    <!-- 文本层级 -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="TextSecondary" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>

    <Style x:Key="TextLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="TextValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="TextSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="FocusRing" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>